# --- Database ---
# Free Postgres: create a project at https://supabase.com (or https://neon.tech)
# and paste its connection string here.
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"

# --- Auth ---
# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# --- Seed admin account (used only by `npm run db:seed`) ---
SEED_ADMIN_EMAIL="admin@nhaa.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Super Admin"
